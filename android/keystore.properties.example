# Copy this file to keystore.properties, in this SAME "android" directory
# (android/keystore.properties — that's Gradle's rootProject for this build),
# and fill in your real values. keystore.properties is git-ignored and must
# never be committed.
#
# storeFile can be an absolute path (e.g. /Users/you/sonobuddy-release.keystore)
# or a path relative to the android/ directory.

storeFile=/Users/anthony/sonobuddy-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=sonobuddy
keyPassword=YOUR_KEY_PASSWORD
